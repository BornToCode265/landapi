<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Malawi Kwacha Coin - Exchange</title>
    <link rel="stylesheet" href="./styles/mystyle.css">
</head>
<body>
    <header>
        <h1>Kwacha Coin</h1>
    </header>

    <div class="container">
        <section id="wallet" class="card fade-in">
            <h2>Your Wallet</h2>
            <p><strong>Address:</strong> <span id="walletAddress">0xCA3...45D</span></p>
            <p><strong>Balance:</strong> <span id="walletBalance">0.00 Kwacha Coin</span></p>
            <p><strong>Equivalent in MWK:</strong> <span id="mwkBalance">1700.00 MWK</span></p>
        </section>

        <section id="exchange" class="card fade-in">
            <h2>Exchange to Kwacha Coin</h2>
            <form>
                <label for="provider">Payment Provider</label>
                <select id="provider" class="input-field">
                    <option value="tnm_mpamba">TNM Mpamba</option>
                    <option value="airtel_money">Airtel Money</option>
                    <option value="bank">Bank</option>
                </select>
                <label for="amount">Amount (MWK)</label>
                <input type="number" id="amount" class="input-field" placeholder="Enter amount">
                <button type="button" class="btn btn-primary" onclick="exchangeToKwachaCoin()">Exchange</button>
            </form>
        </section>

        <section id="send" class="card fade-in">
            <h2>Send Kwacha Coin To Binance Wallet</h2>
            <form>
                <label for="recipientAddress">Recipient Address</label>
                <input type="text" id="recipientAddress" class="input-field" placeholder="Recipient's address">
                <label for="sendAmount">Amount</label>
                <input type="number" id="sendAmount" class="input-field" placeholder="Amount in Kwacha Coin">
                <button type="button" class="btn btn-primary" onclick="sendKwachaCoin()">Send</button>
            </form>
        </section>

        <section id="market" class="card fade-in">
            <h2>Crypto Market</h2>
            <div id="marketData">
                <p><strong>BTC:</strong> <span id="btcPrice">Loading...</span></p>
                <p><strong>ETH:</strong> <span id="ethPrice">Loading...</span></p>
                <p><strong>Others:</strong> <span id="otherPrices">Loading...</span></p>
            </div>
        </section>
    </div>

    <footer>
        <p>&copy; 2024 Kwacha Coin. All rights reserved.</p>
    </footer>

    <script src="./animation/app.js"></script>
</body>

</html>
